<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/ten_dp"
    android:background="@drawable/light_blue_bg"
    android:padding="@dimen/ten_dp">

    <TextView
        android:id="@+id/card_user_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="User Name"
       style="@style/headerTvNevyblueBold17" />

    <TextView
        android:id="@+id/email_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/card_user_tv"
        android:drawablePadding="@dimen/five_dp"
        android:gravity="bottom"
        android:text="Email Id"
        style="@style/titleTvNevyblueRgular17"
        />

    <TextView
        android:id="@+id/card_no__tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/email_tv"
        android:drawablePadding="@dimen/five_dp"
        android:gravity="bottom"
        android:text=""
        style="@style/titleTvNevyblueRgular15"/>

</RelativeLayout>