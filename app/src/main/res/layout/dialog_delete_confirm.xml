<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_light_blue_with_boarder"
    android:padding="15dp">

    <TextView
        android:id="@+id/textView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/five_dp"
        android:gravity="center"
        android:padding="5dp"
        android:text="Delete!"
        style="@style/headerTvNevyblueBold20" />

    <View
        android:id="@+id/view"
        android:layout_below="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/newNavyBuleBaseColor" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_marginTop="15dp"
        android:text="Are you sure you want to delete ?"
       style="@style/headerTvNevyblueBold17" />

    <TextView
        android:id="@+id/tv_delete_notes"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_marginHorizontal="10dp"
        android:text="@string/delete_account_note"
        android:textColor="@color/white"
        android:textSize="14sp"
        />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:weightSum="2">

        <Button
            android:id="@+id/buttonNo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="@dimen/five_dp"
            android:layout_weight="1"
            android:background="@drawable/btn_bg"
            android:text="@string/dialog_no_button"
           style="@style/tvWhiteBoald20" />

        <Button
            android:id="@+id/buttonAdd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="@dimen/five_dp"
            android:layout_weight="1"
            android:background="@drawable/btn_bg"
            android:text="@string/dialog_yes_button"
            style="@style/tvWhiteBoald20" />

    </LinearLayout>

</LinearLayout>
