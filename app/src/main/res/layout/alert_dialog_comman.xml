<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_booking_with_boarder">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="15dp">


        <TextView
            android:id="@+id/title"
            style="@style/blackTransactionboldSubTitleTV"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:gravity="center"
            android:paddingBottom="10dp"
            android:text="Rescheduling failed!" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/newNavyBuleBaseColor" />

            <TextView
                android:layout_marginVertical="15dp"
                android:id="@+id/message"
                style="@style/montserratregular17"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="center_horizontal"
                android:lineSpacingExtra="4dp"
                android:text="The new booking duration cannot be shorter than your original booking. Please select a duration equal to or longer than your previous booking."
                android:textAlignment="center" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">



            <TextView
                android:id="@+id/btn_done"
                style="@style/whiteBoaldBookingTV"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_booking_nevy_blue"
                android:paddingVertical="10dp"
                android:text="Done"
                android:textAlignment="center" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>