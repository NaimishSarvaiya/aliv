<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activity.digitalForm.DigitalFormActivity"
    android:background="@color/white"
    android:orientation="vertical">
    <include
        android:id="@+id/ll_toolbar"
        layout="@layout/booking_toolbar"
        app:layout_constraintTop_toTopOf="parent" />
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tablayoutForm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/header_layout"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:elevation="4dp"
        app:tabGravity="fill"
        app:tabIndicatorColor="@color/newLightBlueBaseColor"
        app:tabIndicatorHeight="2dp"
        app:tabMode="fixed"
        app:tabSelectedTextColor="@color/newLightBlueBaseColor"
        app:tabTextAppearance="@android:style/TextAppearance.Widget.TabWidget"
        app:tabTextColor="@color/newNavyBuleBaseColor" />

    <androidx.viewpager.widget.ViewPager
        android:id="@+id/vpForm"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/rl_createFeedBack"
        android:layout_below="@+id/tablayout_feedback"
        android:layout_marginHorizontal="15dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />


</LinearLayout>