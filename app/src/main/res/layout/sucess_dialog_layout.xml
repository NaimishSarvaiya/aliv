<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_light_blue_with_boarder"
    android:orientation="vertical"
    android:padding="15dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Successfully!"
        android:textAlignment="center"
        style="@style/headerTvNevyblueBold20"/>
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/newNavyBuleBaseColor" />
    <RelativeLayout
        android:layout_marginTop="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_centerInParent="true"
            android:src="@mipmap/green_check"
            app:tint="@color/newLightBlueBaseColor" />

    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:orientation="vertical">

        <TextView
            android:id="@+id/msgTv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Event and Visitor(s) is confirmed. An email confirmation will be sent to you. Visitor(s) will be informed with event details. \n Thank You."
            android:textAlignment="center"
            style="@style/titleTvNevyblueRgular17"/>
        <Button
            android:id="@+id/buttonOk"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="15dp"
            android:background="@drawable/btn_bg"
            android:text="Ok"
           style="@style/whiteBoald20" />

    </LinearLayout>

</LinearLayout>