<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <include
        android:id="@+id/ll_toolbar"
        layout="@layout/booking_toolbar"
        app:layout_constraintTop_toTopOf="parent" />
    <ScrollView
        android:layout_below="@+id/ll_toolbar"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/twenty_dp"
            android:layout_marginTop="@dimen/fourty_sp"
            android:layout_marginRight="@dimen/twenty_dp"
            android:orientation="vertical"
            android:padding="@dimen/five_dp">


            <RelativeLayout
                android:id="@+id/rel_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/light_blue_bg"
                android:padding="@dimen/_12dp"
                >

                <TextView
                    android:layout_centerVertical="true"
                    android:id="@+id/tv_name"
                    style="@style/titleTvNevyblueRgular17"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_toStartOf="@+id/img_change_name"
                    android:hint="Name"
                    android:singleLine="true" />

                <TextView
                    android:id="@+id/img_change_name"
                    style="@style/tvWhiteMedium15"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_alignParentEnd="true"
                    android:layout_margin="5dp"
                    android:background="@drawable/btn_bg"
                    android:paddingStart="8dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="3dp"
                    android:text="Edit" />
            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/rel_user_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ten"
                android:padding="@dimen/_12dp"
                android:background="@drawable/light_blue_bg">

                <TextView
                    android:layout_centerVertical="true"
                    android:id="@+id/edt_user_name"
                    style="@style/titleTvNevyblueRgular17"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_toStartOf="@+id/img_change_uname"
                    android:hint="@string/user_name"
                    android:singleLine="true" />

                <TextView
                    android:id="@+id/img_change_uname"
                    style="@style/tvWhiteMedium15"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_alignParentEnd="true"
                    android:layout_margin="5dp"
                    android:background="@drawable/btn_bg"
                    android:paddingStart="8dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="3dp"
                    android:text="Edit" />


            </RelativeLayout>


            <RelativeLayout
                android:id="@+id/rel_email_id"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ten"
                android:padding="@dimen/_12dp"
                android:background="@drawable/light_blue_bg">

                <TextView
                    android:layout_centerVertical="true"
                    android:id="@+id/edt_email_log_in"
                    style="@style/titleTvNevyblueRgular17"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentTop="true"
                    android:hint="@string/email"
                    android:singleLine="true"
                    android:textCursorDrawable="@null" />


            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/rel_password"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ten"
                android:padding="@dimen/_12dp"
                android:background="@drawable/light_blue_bg">

                <TextView
                    style="@style/titleTvNevyblueRgular17"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentTop="true"
                    android:layout_centerVertical="true"
                    android:text="@string/change_password"
                    android:textColorHint="@color/gray"
                    android:textCursorDrawable="@null" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="18dp"
                    android:layout_alignParentRight="true"
                    android:src="@drawable/right_arrow"
                    app:tint="@color/newLightBlueBaseColor" />
            </RelativeLayout>


            <RelativeLayout
                android:id="@+id/rel_face_registration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ten"
                android:padding="@dimen/_12dp"
                android:background="@drawable/light_blue_bg">

                <TextView
                    android:id="@+id/edt_face_registration"
                    style="@style/titleTvNevyblueRgular17"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentTop="true"
                    android:layout_centerVertical="true"
                    android:singleLine="true"
                    android:text="@string/face_registration"
                    android:textCursorDrawable="@null" />


                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="18dp"
                    android:layout_alignParentRight="true"

                    android:src="@drawable/right_arrow"
                    app:tint="@color/newLightBlueBaseColor" />
            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/rel_removeAccount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ten"
                android:padding="@dimen/_12dp"
                android:background="@drawable/light_blue_bg">

                <TextView
                    android:id="@+id/edt_removeAccount"
                    style="@style/titleTvNevyblueRgular17"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentTop="true"
                    android:layout_centerVertical="true"
                    android:singleLine="true"
                    android:text="@string/delete_account"
                    android:textCursorDrawable="@null" />


                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:layout_alignParentRight="true"

                    android:src="@drawable/ic_delete"
                    app:tint="@color/newLightBlueBaseColor" />
            </RelativeLayout>


            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ten"
                android:background="@drawable/edit_back"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_payment_help"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentLeft="true"
                    android:layout_alignParentTop="true"
                    android:background="@null"
                    android:padding="@dimen/twelve_sp"
                    android:singleLine="true"
                    android:text="@string/payment_help"
                    android:textColor="@color/colorWhite"
                    android:textColorHint="@color/gray"
                    android:textCursorDrawable="@null"
                    android:textSize="@dimen/eighteen_sp" />


                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/menu"
                    android:backgroundTint="@color/colorWhite" />
            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/rel_sign_up"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="45dp"
                android:layout_marginTop="@dimen/fifty_sp"
                android:layout_marginRight="45dp"
                android:background="@drawable/btn_bg"
                android:padding="@dimen/ten"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:clickable="true"
                    android:gravity="center"
                    android:text="@string/create"
                    android:textAllCaps="true"
                    android:textColor="@color/colorWhite"
                    android:textSize="@dimen/eighteen_dp"
                    android:textStyle="bold" />
            </RelativeLayout>
        </LinearLayout>
    </ScrollView>
</RelativeLayout>