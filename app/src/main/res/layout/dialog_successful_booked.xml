<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_light_blue_with_boarder"
    android:padding="15dp">

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:gravity="center"
        android:text="Successful!"
        style="@style/headerTvNevyblueBold20" />

    <View
        android:id="@+id/viewLine"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/newNavyBuleBaseColor"
        android:layout_below="@id/tv_title"/>

    <RelativeLayout
        android:layout_below="@id/viewLine"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="25dp">

        <RelativeLayout
            android:id="@+id/rl_mid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="20dp">

            <ImageView
                android:id="@+id/iv_greenCheck"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_centerHorizontal="true"
                android:src="@mipmap/green_check"
                app:tint="@color/newLightBlueBaseColor" />

            <TextView
                android:id="@+id/tv_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/iv_greenCheck"
                android:layout_marginLeft="@dimen/ten_dp"
                android:layout_marginTop="20dp"
                android:layout_marginRight="@dimen/ten_dp"
                android:gravity="center"
                android:text="@string/you_have_successfully_booked_your_room"
                style="@style/titleTvNevyblueRgular17" />

        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/rl_ok"
            android:layout_width="200dp"
            android:layout_height="45dp"
            android:layout_below="@+id/rl_mid"
            android:layout_centerHorizontal="true"
            android:layout_marginLeft="50dp"
            android:layout_marginTop="30dp"
            android:layout_marginRight="50dp"
            android:background="@drawable/btn_bg">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_centerVertical="true"
                android:text="@string/ok"
                android:textAllCaps="true"
               style="@style/whiteBoald20" />
        </RelativeLayout>


    </RelativeLayout>

</RelativeLayout>
