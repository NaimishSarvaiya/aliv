                        android:layout_gravity="center"
                        android:background="@drawable/new_menu_bg">

                        <ImageView
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:layout_centerInParent="true"
                            android:padding="5dp"
                            android:src="@drawable/visitor"
                            app:tint="@color/newLightBlueBaseColor" />
                    </RelativeLayout>

                    <TextView
                        style="@style/headerTvNevyblueBold13"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:text="@string/visitor" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llAutomation"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <RelativeLayout
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:layout_gravity="center"
                        android:background="@drawable/new_menu_bg">

                        <ImageView
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:layout_centerInParent="true"
                            android:padding="5dp"
                            android:src="@drawable/automation"
                            app:tint="@color/newLightBlueBaseColor" />
                    </RelativeLayout>

                    <TextView
                        style="@style/headerTvNevyblueBold13"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:text="@string/automation" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llForm"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <RelativeLayout
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:layout_gravity="center"
                        android:background="@drawable/new_menu_bg">

                        <ImageView
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:layout_centerInParent="true"
                            android:padding="5dp"
                            android:src="@drawable/contact_form"
                            app:tint="@color/newLightBlueBaseColor" />
                    </RelativeLayout>

                    <TextView
                        style="@style/headerTvNevyblueBold13"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:text="@string/form" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llDevice"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <RelativeLayout
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:layout_gravity="center"
                        android:background="@drawable/new_menu_bg">

                        <ImageView
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:layout_centerInParent="true"
                            android:padding="5dp"
                            android:src="@drawable/door_lock"
                            app:tint="@color/newLightBlueBaseColor" />
                    </RelativeLayout>

                    <TextView
                        style="@style/headerTvNevyblueBold13"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:text="Devices" />
                </LinearLayout>
