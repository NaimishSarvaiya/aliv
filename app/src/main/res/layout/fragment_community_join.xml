<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".fragments.community.CommunityJoinFragment">
    <include
        android:id="@+id/ll_header"
        layout="@layout/booking_toolbar" />

    <EditText
        android:id="@+id/edt_invitation_code"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"
        android:layout_marginStart="@dimen/twenty_dp"
        android:layout_marginLeft="@dimen/twenty_dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="@dimen/twenty_dp"
        android:layout_marginRight="@dimen/twenty_dp"
        android:hint="Enter Community Code"
        android:imeOptions="actionDone"
        android:inputType="textPersonName"
        android:padding="@dimen/twelve_sp"
        android:singleLine="true"
        android:textColorHint="@color/gray"
        android:textCursorDrawable="@null"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView3"
        android:background="@drawable/light_blue_bg"
        style="@style/titleEdtNevyblueRgular17"/>

    <Button
        android:id="@+id/submit_btn"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_centerInParent="true"
        android:layout_marginStart="45dp"
        android:layout_marginLeft="45dp"
        android:layout_marginTop="64dp"
        android:layout_marginEnd="45dp"
        android:layout_marginRight="45dp"
        android:background="@drawable/btn_bg"
        android:gravity="center"
        android:text="@string/submit"
        android:textAllCaps="true"
        style="@style/tvWhitebold17"
        app:layout_constraintEnd_toEndOf="@+id/edt_invitation_code"
        app:layout_constraintStart_toStartOf="@+id/edt_invitation_code"
        app:layout_constraintTop_toBottomOf="@+id/edt_invitation_code" />

    <TextView
        android:id="@+id/textView3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/twenty_dp"
        android:layout_marginLeft="@dimen/twenty_dp"
        android:layout_marginTop="64dp"
        android:layout_marginEnd="@dimen/twenty_dp"
        android:layout_marginRight="@dimen/twenty_dp"
        android:layout_marginBottom="8dp"
        android:gravity="center|start"
        android:text="@string/please_enter_the_community_code_below_to_join_community"
        android:textAppearance="@style/Base.TextAppearance.AppCompat.Large"
        app:layout_constraintBottom_toTopOf="@+id/edt_invitation_code"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ll_header"
        app:layout_constraintVertical_bias="0.0"
        app:layout_constraintVertical_chainStyle="spread_inside"
        style="@style/headerTvNevyblueBold20"/>

</androidx.constraintlayout.widget.ConstraintLayout>