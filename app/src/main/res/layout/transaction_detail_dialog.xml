<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_booking_with_boarder">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="15dp">


        <TextView
            android:id="@+id/title"
            style="@style/blackTransactionboldSubTitleTV"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:gravity="center"
            android:paddingBottom="10dp"
            android:text="Transaction Detail" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/newNavyBuleBaseColor" />

        <ImageView
            android:id="@+id/img_icon"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginVertical="10dp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                style="@style/montserratregular17"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.7"
                android:lineSpacingExtra="4dp"
                android:layout_gravity="center_vertical"
                android:text="Booking ID" />

            <TextView
                android:layout_gravity="center_vertical"
                android:paddingStart="10dp"
                android:id="@+id/tvBookingId"
                style="@style/previewBookingSubTitleTV"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:lineSpacingExtra="4dp"
                android:text="" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.6dp"
            android:layout_marginVertical="8dp"
            android:alpha="0.6"
            android:background="@color/newNavyBuleBaseColor" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                style="@style/montserratregular17"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.7"
                android:lineSpacingExtra="4dp"
                android:layout_gravity="center_vertical"
                android:text="Room Name" />

            <TextView
                android:layout_gravity="center_vertical"
                android:id="@+id/tvRoomName"
                style="@style/previewBookingSubTitleTV"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:paddingStart="10dp"
                android:lineSpacingExtra="4dp"
                android:text="" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.6dp"
            android:layout_marginVertical="8dp"
            android:alpha="0.6"
            android:background="@color/newNavyBuleBaseColor" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                style="@style/montserratregular17"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.7"
                android:lineSpacingExtra="4dp"
                android:layout_gravity="center_vertical"
                android:text="Amount" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_gravity="center_vertical"
                    android:paddingStart="10dp"
                    android:id="@+id/tv_rate"
                    style="@style/previewBookingSubTitleTV"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="4dp"
                    android:text="" />
                <TextView
                    android:layout_gravity="center_vertical"
                    android:paddingStart="10dp"
                    android:id="@+id/tv_refunded"
                    android:layout_marginTop="3dp"
                    style="@style/previewBookingSubTitleTV"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="4dp"
                    android:text="" />
            </LinearLayout>


        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.6dp"
            android:layout_marginVertical="8dp"
            android:alpha="0.6"
            android:background="@color/newNavyBuleBaseColor" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                style="@style/montserratregular17"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.7"
                android:lineSpacingExtra="4dp"
                android:layout_gravity="center_vertical"
                android:text="Transaction Date" />

            <TextView
                android:layout_gravity="center_vertical"
                android:id="@+id/tvDate"
                style="@style/previewBookingSubTitleTV"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:paddingStart="10dp"
                android:lineSpacingExtra="4dp"
                android:text="" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.6dp"
            android:layout_marginVertical="8dp"
            android:alpha="0.6"
            android:background="@color/newNavyBuleBaseColor" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                style="@style/montserratregular17"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.7"
                android:lineSpacingExtra="4dp"
                android:text="Transaction ID" />

            <TextView
                android:layout_gravity="center_vertical"
                android:id="@+id/tvTransactionId"
                style="@style/previewBookingSubTitleTV"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:paddingStart="10dp"
                android:lineSpacingExtra="4dp"
                android:text="" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.6dp"
            android:layout_marginVertical="8dp"
            android:alpha="0.6"
            android:background="@color/newNavyBuleBaseColor" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                style="@style/montserratregular17"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_weight="0.7"
                android:lineSpacingExtra="4dp"
                android:text="Payment Method" />

            <LinearLayout
                android:layout_gravity="center_vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/img_CardImgae"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginRight="10dp"
                    android:scaleType="fitXY"
                    android:src="@drawable/card_visa" />

                <TextView
                    android:id="@+id/tvCardNumber"
                    style="@style/previewBookingSubTitleTV"
                    android:layout_width="0dp"
                    android:layout_gravity="center_vertical"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:lineSpacingExtra="4dp"
                    android:text="" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="horizontal">


            <TextView
                android:id="@+id/btn_done"
                style="@style/whiteBoaldBookingTV"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_booking_nevy_blue"
                android:paddingVertical="10dp"
                android:text="Done"
                android:textAlignment="center" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>