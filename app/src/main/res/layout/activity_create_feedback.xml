<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical"
    tools:context=".activity.feedback.CreateFeedbackActivity">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <RelativeLayout
            android:id="@+id/header_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:background="@color/white"
            android:paddingVertical="7dp"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/img_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:padding="12dp"
                android:src="@drawable/back"
                app:tint="@color/newLightBlueBaseColor" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:orientation="vertical">
            <TextView
                android:layout_gravity="center_horizontal"
                android:id="@+id/tv_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:gravity="center"
                android:textAlignment="center"
                android:text="Feedback"
                style="@style/headerTvLightblueBold20"/>
            <TextView
                android:textAlignment="center"
                android:layout_centerHorizontal="true"
                android:layout_below="@+id/tv_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="to the managment"
                style="@style/headerTvLightblueRegular15"/>
            </LinearLayout>

        </RelativeLayout>
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="15dp"
            android:layout_below="@+id/header_layout"
            android:layout_above="@+id/rl_sendFeedBack">

            <LinearLayout

                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <RelativeLayout
                    android:id="@+id/rl_select_community"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:background="@drawable/light_blue_bg">

                    <TextView
                        android:id="@+id/communityId"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginLeft="@dimen/ten"
                        android:layout_toStartOf="@+id/arrow_down"
                        android:layout_toLeftOf="@+id/arrow_down"
                        android:text="@string/select_community"
                        style="@style/titleTvNevyblueRgular17" />

                    <ImageView
                        android:id="@+id/arrow_down"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_alignParentEnd="true"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"
                        app:srcCompat="@drawable/ic_arrow_down"
                        app:tint="@color/newLightBlueBaseColor" />

                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/rl_select_categry"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:background="@drawable/light_blue_bg">

                    <TextView
                        android:id="@+id/categoryId"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginLeft="@dimen/ten"
                        android:layout_toStartOf="@+id/category_arrow_down"
                        android:layout_toLeftOf="@+id/category_arrow_down"
                        android:text="@string/select_type"
                        style="@style/titleTvNevyblueRgular17"
                       />

                    <ImageView
                        android:id="@+id/category_arrow_down"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_alignParentEnd="true"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"
                        app:srcCompat="@drawable/ic_arrow_down"
                        app:tint="@color/newLightBlueBaseColor"/>

                </RelativeLayout>

                <EditText
                    android:id="@+id/et_feedbackTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:hint="Title"
                    android:maxLines="1"
                    android:maxLength="30"
                    android:padding="10dp"
                    android:background="@drawable/light_blue_bg"
                    style="@style/titleEdtNevyblueRgular17"
                    android:textColorHint="@color/gray" />

                <EditText
                    android:id="@+id/et_feedbackDiscription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:gravity="top"
                    android:hint="@string/discription"
                    android:inputType="textMultiLine"
                    android:lines="10"
                    android:maxLength="1000"
                    android:maxLines="10"
                    android:padding="10dp"
                    android:scrollbars="vertical"
                    android:textColorHint="@color/gray"
                    android:background="@drawable/light_blue_bg"
                    style="@style/titleEdtNevyblueRgular17"/>

                <RelativeLayout
                    android:id="@+id/rl_add_document"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="20dp"
                    android:background="@drawable/light_blue_bg"
                    android:layout_marginTop="20dp">

                    <ImageView
                        android:id="@+id/img_doc"
                        android:layout_width="55dp"
                        android:layout_height="55dp"
                        android:scaleType="fitXY"
                        android:src="@drawable/add_doc_feedback"
                        app:tint="@color/newNavyBuleBaseColor" />

                    <TextView
                        style="@style/headerTvNevyblueBold17"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"
                        android:text="@string/tap_to_upload_n_jpg_jpeg_png_or_pdf"
                        android:textAlignment="textEnd" />
                </RelativeLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>


        <RelativeLayout
            android:layout_centerHorizontal="true"
            android:id="@+id/rl_sendFeedBack"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:padding="10dp"
            android:layout_alignParentBottom="true"
            android:background="@color/newLightBlueBaseColor">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="@string/send_feedback"
                android:textAllCaps="true"
                style="@style/whiteBoald20" />
        </RelativeLayout>


    </RelativeLayout>
</LinearLayout>