<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_booking_with_boarder">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="15dp">


        <TextView
            android:id="@+id/title"
            style="@style/blackTransactionboldSubTitleTV"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:gravity="center"
            android:paddingBottom="10dp"
            android:text="Confirm Cancelation" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/newNavyBuleBaseColor" />
        <ImageView
            android:visibility="gone"
            android:layout_gravity="center_horizontal"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginVertical="10dp"
            android:id="@+id/img_icon"/>
        <ScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
        <TextView
            android:layout_marginVertical="15dp"
            android:id="@+id/message"
            style="@style/montserratregular17"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="center_horizontal"
            android:lineSpacingExtra="4dp"
            android:text="Are you sure you want to remove \n this card?"
            android:textAlignment="center" />
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_not_now"
                style="@style/whiteBoaldBookingTV"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_booking_nevy_blue"
                android:paddingVertical="10dp"
                android:text="Cancel"
                android:textAlignment="center" />

            <TextView
                android:id="@+id/btn_confirm"
                style="@style/whiteBoaldBookingTV"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_booking_nevy_blue"
                android:paddingVertical="10dp"
                android:text="Delete"
                android:textAlignment="center" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>