<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <RelativeLayout
        android:id="@+id/header_layout"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/White"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/imgBackCreateSchedule"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="@dimen/ten_dp"
            android:src="@drawable/back"
            app:tint="@color/newLightBlueBaseColor" />

        <TextView
            android:id="@+id/tv_header"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:padding="@dimen/ten_dp"
            android:text="@string/create_schedules"
            style="@style/headerTvLightblueBold20" />
    </RelativeLayout>


    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/create_schedule_btn"
        android:layout_marginHorizontal="15dp"
        android:layout_marginBottom="10dp"
        android:layout_below="@id/header_layout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/twenty_dp"
                android:text="Select Date Range"
                style="@style/headerTvNevyblueBold20"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:background="@drawable/light_blue_bg"
                android:orientation="vertical"
                android:padding="@dimen/ten_dp">

                <LinearLayout
                    android:id="@+id/ll_select_date"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="3dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginRight="3dp"
                    android:layout_marginBottom="@dimen/ten_dp"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:gravity="center_vertical"
                            android:text="@string/start_date_"
                            style="@style/titleTvNevyblueRgular15" />

                        <TextView
                            android:id="@+id/tv_start_date"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ten_dp"
                            android:background="@drawable/dark_light_blue_bg"
                            android:gravity="center"
                            android:hint="@string/select_date"
                            android:padding="12dp"
                            android:singleLine="true"
                            style="@style/headerTvNevyblueBold17"
                            android:textColorHint="@color/gray" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/ten_dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:gravity="center_vertical"
                            android:text="@string/end_date_"
                            style="@style/titleTvNevyblueRgular15" />

                        <TextView
                            android:id="@+id/tv_end_date"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ten_dp"
                            android:background="@drawable/dark_light_blue_bg"
                            android:gravity="center"
                            android:hint="@string/select_date"
                            android:padding="12dp"
                            android:singleLine="true"

                            android:textColorHint="@color/gray"
                            style="@style/headerTvNevyblueBold17" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ten_dp"
                android:layout_marginRight="@dimen/ten_dp"
                android:background="@drawable/light_blue_bg"
                android:orientation="horizontal">

                <RelativeLayout
                    android:id="@+id/rl_first"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginRight="@dimen/ten_dp">

                    <CheckBox
                        android:id="@+id/checkboxMon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginLeft="15dp"
                        android:layout_marginRight="@dimen/ten_dp"
                        android:button="@drawable/checkbox_white"
                        android:paddingLeft="5dp"
                        android:text="Monday"
                        style="@style/headerTvNevyblueBold17"  />

                    <TextView
                        android:id="@+id/tv_addTimeSlot"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"
                        android:drawableLeft="@mipmap/ic_add_orange_circle"
                        android:drawablePadding="5dp"
                        android:text="Add time slot"
                        android:drawableTint="@color/newLightBlueBaseColor"
                        style="@style/headerTvLightblueBold17"
                        android:visibility="gone" />
                </RelativeLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerView_time_slot"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/rl_first"
                    android:layout_marginLeft="@dimen/ten_dp"
                    android:layout_marginTop="@dimen/ten_dp"
                    android:layout_marginBottom="@dimen/ten_dp" />

            </RelativeLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ten_dp"
                android:layout_marginRight="@dimen/ten_dp"
                android:background="@drawable/light_blue_bg"
                android:orientation="horizontal">

                <RelativeLayout
                    android:id="@+id/rl_firstTue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginRight="@dimen/ten_dp">

                    <CheckBox
                        android:id="@+id/checkboxTue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginLeft="15dp"
                        android:layout_marginRight="@dimen/ten_dp"
                        android:button="@drawable/checkbox_white"
                        android:paddingLeft="5dp"
                        android:text="Tuesday"
                        style="@style/headerTvNevyblueBold17" />


                    <TextView
                        android:id="@+id/addSlotTue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"
                        android:drawableLeft="@mipmap/ic_add_orange_circle"
                        android:drawablePadding="5dp"
                        android:text="Add time slot"
                        android:drawableTint="@color/newLightBlueBaseColor"
                        style="@style/headerTvLightblueBold17"
                        android:visibility="gone" />
                </RelativeLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerView_time_tues"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/rl_firstTue"
                    android:layout_marginLeft="@dimen/ten_dp"
                    android:layout_marginTop="@dimen/ten_dp"
                    android:layout_marginRight="@dimen/ten_dp"
                    android:layout_marginBottom="@dimen/ten_dp" />

            </RelativeLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ten_dp"
                android:layout_marginRight="@dimen/ten_dp"
                android:background="@drawable/light_blue_bg"
                android:orientation="horizontal">

                <RelativeLayout
                    android:id="@+id/rl_firstWed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginRight="@dimen/ten_dp">

                    <CheckBox
                        android:id="@+id/checkbox_wed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginLeft="15dp"
                        android:layout_marginRight="@dimen/ten_dp"
                        android:button="@drawable/checkbox_white"
                        android:paddingLeft="5dp"
                        android:text="Wednesday"
                        style="@style/headerTvNevyblueBold17" />

                    <TextView
                        android:id="@+id/tv_addTimeSlot_wed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"
                        android:drawableLeft="@mipmap/ic_add_orange_circle"
                        android:drawablePadding="5dp"
                        android:text="Add time slot"
                        android:drawableTint="@color/newLightBlueBaseColor"
                        style="@style/headerTvLightblueBold17"
                        android:visibility="gone" />
                </RelativeLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerView_time_wed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/rl_firstWed"
                    android:layout_marginLeft="@dimen/ten_dp"
                    android:layout_marginTop="@dimen/ten_dp"
                    android:layout_marginRight="@dimen/ten_dp"
                    android:layout_marginBottom="@dimen/ten_dp" />


            </RelativeLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ten_dp"
                android:layout_marginRight="@dimen/ten_dp"
                android:background="@drawable/light_blue_bg"
                android:orientation="horizontal">

                <RelativeLayout
                    android:id="@+id/rl_first_thurs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginRight="@dimen/ten_dp">

                    <CheckBox
                        android:id="@+id/checkbox_thurs"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginLeft="15dp"
                        android:layout_marginRight="@dimen/ten_dp"
                        android:button="@drawable/checkbox_white"
                        android:paddingLeft="5dp"
                        android:text="Thursday"
                        style="@style/headerTvNevyblueBold17" />

                    <TextView
                        android:id="@+id/tv_addTimeSlot_thurs"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"
                        android:drawableLeft="@mipmap/ic_add_orange_circle"
                        android:drawablePadding="5dp"
                        android:text="Add time slot"
                        android:drawableTint="@color/newLightBlueBaseColor"
                        style="@style/headerTvLightblueBold17"
                        android:visibility="gone" />
                </RelativeLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerView_time_thurs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/rl_first_thurs"
                    android:layout_marginLeft="@dimen/ten_dp"
                    android:layout_marginTop="@dimen/ten_dp"
                    android:layout_marginRight="@dimen/ten_dp"
                    android:layout_marginBottom="@dimen/ten_dp" />


            </RelativeLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ten_dp"
                android:layout_marginRight="@dimen/ten_dp"
                android:background="@drawable/light_blue_bg"
                android:orientation="horizontal">

                <RelativeLayout
                    android:id="@+id/rl_first_fri"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginRight="@dimen/ten_dp">

                    <CheckBox
                        android:id="@+id/checkbox_fri"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginLeft="15dp"
                        android:layout_marginRight="@dimen/ten_dp"
                        android:button="@drawable/checkbox_white"
                        android:paddingLeft="5dp"
                        android:text="Friday"
                        style="@style/headerTvNevyblueBold17" />

                    <TextView
                        android:id="@+id/tv_addTimeSlot_fri"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"
                        android:drawableLeft="@mipmap/ic_add_orange_circle"
                        android:drawablePadding="5dp"
                        android:text="Add time slot"
                        android:drawableTint="@color/newLightBlueBaseColor"
                        style="@style/headerTvLightblueBold17"
                        android:visibility="gone" />
                </RelativeLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerView_time_fri"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/rl_first_fri"
                    android:layout_marginLeft="@dimen/ten_dp"
                    android:layout_marginTop="@dimen/ten_dp"
                    android:layout_marginRight="@dimen/ten_dp"
                    android:layout_marginBottom="@dimen/ten_dp" />


            </RelativeLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ten_dp"
                android:layout_marginRight="@dimen/ten_dp"
                android:background="@drawable/light_blue_bg"
                android:orientation="horizontal">

                <RelativeLayout
                    android:id="@+id/rl_first_sat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginRight="@dimen/ten_dp">

                    <CheckBox
                        android:id="@+id/checkbox_sat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginLeft="15dp"
                        android:layout_marginRight="@dimen/ten_dp"
                        android:button="@drawable/checkbox_white"
                        android:paddingLeft="5dp"
                        android:text="Saturday"
                        style="@style/headerTvNevyblueBold17"/>

                    <TextView
                        android:id="@+id/tv_addTimeSlot_sat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"
                        android:drawableLeft="@mipmap/ic_add_orange_circle"
                        android:drawablePadding="5dp"
                        android:text="Add time slot"
                        style="@style/headerTvLightblueBold17"
                        android:drawableTint="@color/newLightBlueBaseColor"
                        android:visibility="gone" />
                </RelativeLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerView_time_sat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/rl_first_sat"
                    android:layout_marginLeft="@dimen/ten_dp"
                    android:layout_marginTop="@dimen/ten_dp"
                    android:layout_marginRight="@dimen/ten_dp"
                    android:layout_marginBottom="@dimen/ten_dp" />


            </RelativeLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ten_dp"
                android:layout_marginRight="@dimen/ten_dp"
                android:background="@drawable/light_blue_bg"
                android:orientation="horizontal">

                <RelativeLayout
                    android:id="@+id/rl_first_sun"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginRight="@dimen/ten_dp">

                    <CheckBox
                        android:id="@+id/checkbox_sun"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginLeft="15dp"
                        android:layout_marginRight="@dimen/ten_dp"
                        android:button="@drawable/checkbox_white"
                        android:paddingLeft="5dp"
                        android:text="Sunday"
                        style="@style/headerTvNevyblueBold17" />

                    <TextView
                        android:id="@+id/tv_addTimeSlot_sun"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"
                        android:drawableLeft="@mipmap/ic_add_orange_circle"
                        android:drawablePadding="5dp"
                        android:text="Add time slot"
                        style="@style/headerTvLightblueBold17"
                        android:drawableTint="@color/newLightBlueBaseColor"
                        android:visibility="gone" />
                </RelativeLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerView_time_sun"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/rl_first_sun"
                    android:layout_marginLeft="@dimen/ten_dp"
                    android:layout_marginTop="@dimen/ten_dp"
                    android:layout_marginRight="@dimen/ten_dp"
                    android:layout_marginBottom="@dimen/ten_dp" />


            </RelativeLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <Button
        android:id="@+id/create_schedule_btn"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentBottom="true"
        android:background="@color/newLightBlueBaseColor"
        android:text="@string/submit"
        style="@style/tvWhiteBoald20" />

</RelativeLayout>