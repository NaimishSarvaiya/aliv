<!-- res/drawable/shape_with_shadow.xml -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Shadow Layer (background) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#50000000" /> <!-- Semi-transparent black shadow -->
            <corners android:radius="15dp"/> <!-- Match the corner radius -->
        </shape>
    </item>

    <!-- Actual Shape with Rounded Corners -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/white" />
            <corners android:topLeftRadius="15dp"
                android:topRightRadius="15dp" />
        </shape>
    </item>

</layer-list>
